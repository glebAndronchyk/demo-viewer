' ── Bomb / Hostage events ──────────────────────────────────
class BombPlantedEvent extends MatchEvent {
    +type: "bomb_planted"
    +playerSteamId64: string
    +site: "A" | "B" | "Unknown"
}
class BombDefuseStartEvent extends MatchEvent {
    +type: "bomb_defuse_start"
    +playerSteamId64: string
    +hasKit: boolean
}
class BombDefuseAbortedEvent extends MatchEvent {
    +type: "bomb_defuse_aborted"
    +playerSteamId64: string
}
class BombDefusedEvent extends MatchEvent {
    +type: "bomb_defused"
    +playerSteamId64: string
}
class BombExplodedEvent extends MatchEvent {
    +type: "bomb_exploded"
    +site: "A" | "B" | "Unknown"
}
class HostageRescuedEvent extends MatchEvent {
    +type: "hostage_rescued"
    +playerSteamId64: string
}

' ── Item events ────────────────────────────────────────────
class ItemPickupEventQueryBuilder extends AnalyticsQueryBuilder {
    +forPlayer(steamId64: string): this
    +asBought(): this
}
class ItemPickupEvent extends MatchEvent {
    +type: "item_pickup"
    +playerSteamId64: string
    +weapon: WeaponType
    +isBought: boolean
    +weaponEntityId: string
}
class ItemDropEventQueryBuilder extends AnalyticsQueryBuilder {
    +asPlayer(steamId64: string): this
}
class ItemDropEvent extends MatchEvent {
    +type: "item_drop"
    +playerSteamId64: string
    +weapon: string
    +weaponEntityId: string
}
class ItemRefundEventQueryBuilder extends AnalyticsQueryBuilder {
    +asPlayer(steamId64: string): this
}
class ItemRefundEvent extends MatchEvent {
    +type: "item_refund"
    +playerSteamId64: string
    +weapon: string
    +weaponEntityId: string
}

' ── QueryBuilder associations ──────────────────────────────
KillEvent ..> KillEventQueryBuilder : built by
PlayerHurtEvent ..> PlayerHurtEventQueryBuilder : built by
WeaponFireEvent ..> WeaponFireEventQueryBuilder : built by
PlayerFlashedEvent ..> PlayerFlashedEventQueryBuilder : built by
GrenadeThrowEvent ..> GrenadeThrowEventQueryBuilder : built by
GrenadeFireStartEvent ..> GrenadeFireStartEventQueryBuilder : built by
GrenadeFireEndEvent ..> GrenadeFireEndEventQueryBuilder : built by
GrenadeFlashExplodeEvent ..> GrenadeFlashExplodeEventQueryBuilder : built by
GrenadeHeExplodeEvent ..> GrenadeHeExplodeEventQueryBuilder : built by
GrenadeDestroyEvent ..> GrenadeDestroyEventQueryBuilder : built by
ItemPickupEvent ..> ItemPickupEventQueryBuilder : built by
ItemDropEvent ..> ItemDropEventQueryBuilder : built by
ItemRefundEvent ..> ItemRefundEventQueryBuilder : built by

@enduml
