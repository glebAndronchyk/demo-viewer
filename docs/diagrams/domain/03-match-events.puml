@startuml
skinparam classAttributeIconSize 0
skinparam pageMargin 10
skinparam classFontSize 10
left to right direction

abstract class MatchEvent {
    +{abstract} type: string
    +{static} filterObject: Record<string, unknown>
    +{static} withBuilder(ctor): typeof BuiltBase
}

abstract class AnalyticsQueryBuilder<T extends MatchEvent> {
    #filterObject: Record<string, any>
    #tickFilter: Record<string, any>
    +inTickRange(range: [number, number]): this
    +build(): EventConstructor<T>
}

' ── Round events ──────────────────────────────────────────
class RoundStartEvent extends MatchEvent {
    +type: "round_start"
    +timeLimit: number
    +fragLimit: number
    +objective: string
}
class RoundFreezetimeEndEvent extends MatchEvent {
    +type: "round_freezetime_end"
}
class RoundEndEvent extends MatchEvent {
    +type: "round_end"
    +winner: "Unknown" | "T" | "CT" | "Spectators"
    +reason: string
}
class RoundEndOfficialEvent extends MatchEvent {
    +type: "round_end_official"
}

' ── Kill / Damage events ───────────────────────────────────
class KillEventQueryBuilder extends AnalyticsQueryBuilder {
    +asKiller(steamId64: string): this
    +asVictim(steamId64: string): this
    +asAssister(steamId64: string): this
    +asHeadshot(): this
}
class KillEvent extends MatchEvent {
    +type: "kill"
    +killerSteamId64: string
    +killerName: string
    +victimSteamId64: string
    +victimName: string
    +assisterSteamId64: string
    +assisterName: string
    +weapon: string
    +isHeadshot: boolean
    +penetratedObjects: number
}
class PlayerHurtEventQueryBuilder extends AnalyticsQueryBuilder {
    +asAttacker(steamId64: string): this
    +withWeaponInRange(weapons: WeaponType[]): this
}
class PlayerHurtEvent extends MatchEvent {
    +type: "player_hurt"
    +playerSteamId64: string
    +attackerSteamId64: string
    +healthDamage: number
    +armorDamage: number
    +weapon: WeaponType
    +hitGroup: HitGroup
}
class WeaponFireEventQueryBuilder extends AnalyticsQueryBuilder {
    +asShooter(steamId64: string): this
}
class WeaponFireEvent extends MatchEvent {
    +type: "weapon_fire"
    +shooterSteamId64: string
    +weapon: string
}
class WeaponReloadEvent extends MatchEvent {
    +type: "weapon_reload"
    +playerSteamId64: string
}

' ── Flash events ───────────────────────────────────────────
class PlayerFlashedEventQueryBuilder extends AnalyticsQueryBuilder {
    +asAttacker(steamId64: string): this
    +withTargetPlayerTeam(team: TeamType): this
}
class PlayerFlashedEvent extends MatchEvent {
    +type: "player_flashed"
    +playerSteamId64: string
    +attackerSteamId64: string
    +flashDuration: number
    +attackerTeam: TeamType
    +playerTeam: TeamType
}

' ── Player connection events ───────────────────────────────
class PlayerConnectEvent extends MatchEvent {
    +type: "player_connect"
    +steamId64: string
    +name: string
}
class PlayerDisconnectEvent extends MatchEvent {
    +type: "player_disconnect"
    +steamId64: string
    +name: string
}

